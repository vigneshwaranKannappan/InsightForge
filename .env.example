# Copy to .env and fill in. Never commit the real .env file.
# Leave LLM_PROVIDER blank to run offline (retrieved statistics only, no LLM calls).

# openai | anthropic
LLM_PROVIDER=
# Optional override. Defaults: openai -> gpt-4o-mini, anthropic -> claude-haiku-5-5
LLM_MODEL=
LLM_TEMPERATURE=0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
